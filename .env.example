# Copy this file to ".env" and fill it in. Never commit ".env" (it is in .gitignore).

# From @BotFather when you create the bot.
TELEGRAM_BOT_TOKEN=

# Where to send the digest. Message your bot once, then run:  python -m leadwatch --find-chat
TELEGRAM_CHAT_ID=

# Path or "published to the web" CSV link of the lead sheet.
# Leave empty to use the demo data in data/leads_demo.csv.
LEADWATCH_SOURCE=

# Hours between UTC and the timezone your sheet's timestamps are written in.
# Minsk = 3, Dubai = 4.
LEADWATCH_UTC_OFFSET=3
